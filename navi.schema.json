{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "corpuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": ["files", "web", "custom"]
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "embed": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "surfacing": {
            "type": "object",
            "properties": {
              "repeat": {
                "type": "string",
                "enum": ["eager", "normal", "once"]
              },
              "force": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "priority": {
                "type": "number"
              },
              "minTurn": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cooldown": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["id", "type"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "custom"
                }
              }
            },
            "then": {
              "required": ["module"]
            },
            "else": {
              "not": {
                "required": ["module"]
              }
            }
          }
        ]
      }
    },
    "analyzer": {
      "type": "object",
      "properties": {
        "detectors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "disabled": {
                "type": "boolean"
              }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "preferSession": {
            "default": true,
            "type": "boolean"
          },
          "runner": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "opencode"
                  }
                },
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "systemone"
                  },
                  "baseUrl": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["type", "baseUrl"],
                "additionalProperties": false
              }
            ]
          },
          "timeoutMs": {
            "default": 10000,
            "type": "integer",
            "minimum": 100,
            "maximum": 9007199254740991
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["id", "model", "runner"],
        "additionalProperties": false
      }
    },
    "embeddings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "const": "openai-compatible"
          },
          "baseUrl": {
            "type": "string",
            "minLength": 1
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "default": 10000,
            "type": "integer",
            "minimum": 100,
            "maximum": 9007199254740991
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["id", "type", "baseUrl", "model"],
        "additionalProperties": false
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "topK": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": ["provider"],
      "additionalProperties": false
    },
    "surfacing": {
      "type": "object",
      "properties": {
        "repetition": {
          "type": "object",
          "properties": {
            "perTurn": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "perSession": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxHits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "byModel": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "repetition": {
                "type": "object",
                "properties": {
                  "perTurn": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "perSession": {
                    "default": 3,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "budget": {
                "type": "object",
                "properties": {
                  "maxHits": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["corpuses"],
  "additionalProperties": false
}
