{
  "name": "navi",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "navi": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "evals/fixtures/navi.json",
    "evals/fixtures/labels.jsonl",
    "evals/fixtures/docs"
  ],
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*"
  },
  "exports": {
    ".": "./dist/main.mjs",
    "./core": {
      "development": "./src/core/contract.ts",
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    }
  },
  "scripts": {
    "cli": "vpx src/cli/main.ts",
    "prepare": "vp config",
    "schema": "vpx ./scripts/emit-navi-schema.ts && vp check --fix navi.schema.json"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
